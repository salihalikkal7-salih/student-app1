<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduFlow — Modern Student Management System</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="logo-icon"><i class="fas fa-graduation-cap"></i></div>
                <span class="logo-text">EduFlow</span>
                <button id="sidebar-toggle" class="sidebar-toggle"><i class="fas fa-bars"></i></button>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li class="active" data-target="dashboard-view">
                        <a href="#"><i class="fas fa-th-large"></i><span>Dashboard</span></a>
                    </li>
                    <li data-target="students-view">
                        <a href="#"><i class="fas fa-user-graduate"></i><span>Students</span></a>
                    </li>
                    <li data-target="teachers-view">
                        <a href="#"><i class="fas fa-chalkboard-teacher"></i><span>Teachers</span></a>
                    </li>
                    <li data-target="classes-view">
                        <a href="#"><i class="fas fa-school"></i><span>Classes</span></a>
                    </li>
                    <li data-target="attendance-view">
                        <a href="#"><i class="fas fa-calendar-check"></i><span>Attendance</span></a>
                    </li>
                    <li data-target="fees-view">
                        <a href="#"><i class="fas fa-file-invoice-dollar"></i><span>Fees</span></a>
                    </li>
                    <li data-target="reports-view">
                        <a href="#"><i class="fas fa-chart-line"></i><span>Reports</span></a>
                    </li>
                    <li data-target="settings-view">
                        <a href="#"><i class="fas fa-cog"></i><span>Settings</span></a>
                    </li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <div class="user-mini-profile">
                    <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&q=80&w=100" alt="Admin">
                    <div class="user-info">
                        <h4 id="sidebar-admin-name">Dr. Robert Vance</h4>
                        <p>System Administrator</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <div class="nav-left">
                    <button id="mobile-menu-btn" class="mobile-menu-btn"><i class="fas fa-bars"></i></button>
                    <div class="search-bar">
                        <i class="fas fa-search"></i>
                        <input type="text" id="global-search" placeholder="Search students, teachers, classes...">
                    </div>
                </div>
                <div class="nav-right">
                    <div class="dropdown notification-dropdown">
                        <button class="icon-btn" id="notification-btn">
                            <i class="fas fa-bell"></i>
                            <span class="badge">3</span>
                        </button>
                        <div class="dropdown-menu notification-menu" id="notification-menu">
                            <div class="dropdown-header">
                                <h3>Notifications</h3>
                                <span class="mark-read">Mark all as read</span>
                            </div>
                            <div class="dropdown-body">
                                <div class="notification-item unread">
                                    <i class="fas fa-user-plus text-primary"></i>
                                    <div>
                                        <p>New student registration: Alex Morgan</p>
                                        <span class="time">10 mins ago</span>
                                    </div>
                                </div>
                                <div class="notification-item unread">
                                    <i class="fas fa-file-invoice-dollar text-warning"></i>
                                    <div>
                                        <p>Fee payment received from Class 10-A</p>
                                        <span class="time">1 hour ago</span>
                                    </div>
                                </div>
                                <div class="notification-item">
                                    <i class="fas fa-calendar-check text-success"></i>
                                    <div>
                                        <p>Attendance submitted for Class 9-B</p>
                                        <span class="time">3 hours ago</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="profile-menu">
                        <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?auto=format&fit=crop&q=80&w=100" alt="Profile">
                        <span class="profile-name" id="topbar-admin-name">Dr. Robert Vance</span>
                    </div>
                </div>
            </header>

            <!-- Views Container -->
            <div class="views-container">

                <!-- 1. DASHBOARD VIEW -->
                <section id="dashboard-view" class="view-section active">
                    <div class="view-header">
                        <div>
                            <h1 id="welcome-heading">Welcome back, Admin!</h1>
                            <p>Here is what is happening in your institution today.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-primary" onclick="app.switchView('students-view')"><i class="fas fa-user-plus"></i> Add Student</button>
                        </div>
                    </div>

                    <!-- Summary Cards -->
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-icon bg-blue"><i class="fas fa-user-graduate"></i></div>
                            <div class="stat-details">
                                <h3 id="stat-total-students">0</h3>
                                <p>Total Students</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-green"><i class="fas fa-chalkboard-teacher"></i></div>
                            <div class="stat-details">
                                <h3 id="stat-total-teachers">0</h3>
                                <p>Total Teachers</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-purple"><i class="fas fa-school"></i></div>
                            <div class="stat-details">
                                <h3 id="stat-total-classes">0</h3>
                                <p>Total Classes</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-orange"><i class="fas fa-user-check"></i></div>
                            <div class="stat-details">
                                <h3 id="stat-present-today">0</h3>
                                <p>Present Today</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-red"><i class="fas fa-file-invoice-dollar"></i></div>
                            <div class="stat-details">
                                <h3 id="stat-pending-fees">$0</h3>
                                <p>Pending Fees</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-teal"><i class="fas fa-chart-pie"></i></div>
                            <div class="stat-details">
                                <h3 id="stat-attendance-percentage">0%</h3>
                                <p>Attendance Rate</p>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Row -->
                    <div class="charts-grid">
                        <div class="card chart-card">
                            <div class="card-header">
                                <h3>Student Enrollment Trends</h3>
                                <select id="enrollment-filter" class="form-control-sm">
                                    <option value="2026">2026</option>
                                    <option value="2025">2025</option>
                                </select>
                            </div>
                            <div class="card-body">
                                <canvas id="enrollmentChart"></canvas>
                            </div>
                        </div>
                        <div class="card chart-card">
                            <div class="card-header">
                                <h3>Weekly Attendance Overview</h3>
                            </div>
                            <div class="card-body">
                                <canvas id="attendanceChart"></canvas>
                            </div>
                        </div>
                    </div>

                    <!-- Lower Dashboard Grid -->
                    <div class="dashboard-lower-grid">
                        <div class="card">
                            <div class="card-header">
                                <h3>Recent Student Registrations</h3>
                                <button class="btn-link" onclick="app.switchView('students-view')">View All</button>
                            </div>
                            <div class="card-body table-responsive">
                                <table class="table" id="dashboard-recent-students">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>Class</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">
                                <h3>Recent Activity Feed</h3>
                            </div>
                            <div class="card-body">
                                <div class="activity-feed" id="activity-feed-list"></div>
                            </div>
                        </div>

                        <div class="card">
                            <div class="card-header">
                                <h3>Upcoming Events & Exams</h3>
                            </div>
                            <div class="card-body">
                                <div class="events-list" id="events-list">
                                    <div class="event-item">
                                        <div class="event-date"><span>15</span>Nov</div>
                                        <div class="event-info">
                                            <h4>Mid-Term Mathematics Exam</h4>
                                            <p>All Grade 10 & 11 Students</p>
                                        </div>
                                    </div>
                                    <div class="event-item">
                                        <div class="event-date"><span>22</span>Nov</div>
                                        <div class="event-info">
                                            <h4>Annual Science Fair 2026</h4>
                                            <p>Main Auditorium, 10:00 AM</p>
                                        </div>
                                    </div>
                                    <div class="event-item">
                                        <div class="event-date"><span>05</span>Dec</div>
                                        <div class="event-info">
                                            <h4>Parent-Teacher Conference</h4>
                                            <p>Virtual & On-site Meetings</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 2. STUDENTS VIEW -->
                <section id="students-view" class="view-section">
                    <div class="view-header">
                        <div>
                            <h1>Student Management</h1>
                            <p>Manage all student records, admissions, and status.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-outline" onclick="app.exportStudentsCSV()"><i class="fas fa-file-csv"></i> Export CSV</button>
                            <button class="btn btn-primary" onclick="app.openStudentModal()"><i class="fas fa-user-plus"></i> Add Student</button>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-filter-bar">
                            <div class="search-box">
                                <i class="fas fa-search"></i>
                                <input type="text" id="student-search" placeholder="Search by name, ID, email...">
                            </div>
                            <div class="filter-group">
                                <select id="filter-student-class" class="form-control">
                                    <option value="">All Classes</option>
                                </select>
                                <select id="filter-student-gender" class="form-control">
                                    <option value="">All Genders</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <select id="filter-student-status" class="form-control">
                                    <option value="">All Statuses</option>
                                    <option value="Active">Active</option>
                                    <option value="Inactive">Inactive</option>
                                </select>
                                <button class="btn btn-secondary" onclick="app.resetStudentFilters()">Reset</button>
                            </div>
                        </div>
                        <div class="card-body table-responsive">
                            <table class="table" id="students-table">
                                <thead>
                                    <tr>
                                        <th onclick="app.sortStudents('id')">ID <i class="fas fa-sort"></i></th>
                                        <th>Photo</th>
                                        <th onclick="app.sortStudents('name')">Full Name <i class="fas fa-sort"></i></th>
                                        <th>Gender</th>
                                        <th>DOB</th>
                                        <th onclick="app.sortStudents('className')">Class <i class="fas fa-sort"></i></th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Enrollment</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="students-table-body"></tbody>
                            </table>
                        </div>
                        <div class="card-footer pagination-footer">
                            <div id="student-count-info">Showing 0 of 0 students</div>
                            <div class="pagination" id="student-pagination"></div>
                        </div>
                    </div>
                </section>

                <!-- 3. TEACHERS VIEW -->
                <section id="teachers-view" class="view-section">
                    <div class="view-header">
                        <div>
                            <h1>Teacher Management</h1>
                            <p>Manage faculty members, subjects, and class assignments.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-primary" onclick="app.openTeacherModal()"><i class="fas fa-plus"></i> Add Teacher</button>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-filter-bar">
                            <div class="search-box">
                                <i class="fas fa-search"></i>
                                <input type="text" id="teacher-search" placeholder="Search teachers...">
                            </div>
                        </div>
                        <div class="card-body table-responsive">
                            <table class="table" id="teachers-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Subject</th>
                                        <th>Email</th>
                                        <th>Phone</th>
                                        <th>Assigned Class</th>
                                        <th>Joining Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="teachers-table-body"></tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- 4. CLASSES VIEW -->
                <section id="classes-view" class="view-section">
                    <div class="view-header">
                        <div>
                            <h1>Class Management</h1>
                            <p>Organize grades, sections, classrooms, and homeroom teachers.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-primary" onclick="app.openClassModal()"><i class="fas fa-plus"></i> Add Class</button>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body table-responsive">
                            <table class="table" id="classes-table">
                                <thead>
                                    <tr>
                                        <th>Class ID</th>
                                        <th>Class Name</th>
                                        <th>Section</th>
                                        <th>Class Teacher</th>
                                        <th>Students Count</th>
                                        <th>Room Number</th>
                                        <th>Academic Year</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="classes-table-body"></tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- 5. ATTENDANCE VIEW -->
                <section id="attendance-view" class="view-section">
                    <div class="view-header">
                        <div>
                            <h1>Attendance Management</h1>
                            <p>Record and monitor daily student attendance.</p>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-filter-bar attendance-controls">
                            <div class="form-group">
                                <label>Select Date:</label>
                                <input type="date" id="attendance-date" class="form-control">
                            </div>
                            <div class="form-group">
                                <label>Select Class:</label>
                                <select id="attendance-class-select" class="form-control">
                                    <option value="">Choose Class...</option>
                                </select>
                            </div>
                            <div class="form-actions-inline">
                                <button class="btn btn-primary" onclick="app.loadAttendanceList()">Load Students</button>
                                <button class="btn btn-success" onclick="app.markAllAttendance('Present')">Mark All Present</button>
                            </div>
                        </div>
                        <div class="card-body table-responsive">
                            <table class="table" id="attendance-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Student Name</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="attendance-table-body">
                                    <tr><td colspan="4" class="text-center">Please select a date and class to take attendance.</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer text-right" id="attendance-save-footer" style="display: none;">
                            <button class="btn btn-primary" onclick="app.saveAttendance()"><i class="fas fa-save"></i> Save Attendance</button>
                        </div>
                    </div>
                </section>

                <!-- 6. FEES VIEW -->
                <section id="fees-view" class="view-section">
                    <div class="view-header">
                        <div>
                            <h1>Fees Management</h1>
                            <p>Track student tuition, balances, and payment statuses.</p>
                        </div>
                        <div class="view-actions">
                            <button class="btn btn-outline" onclick="app.exportFeesCSV()"><i class="fas fa-file-csv"></i> Export CSV</button>
                            <button class="btn btn-primary" onclick="app.openFeeModal()"><i class="fas fa-plus"></i> Add Fee Record</button>
                        </div>
                    </div>

                    <div class="stats-grid mb-4">
                        <div class="stat-card">
                            <div class="stat-icon bg-green"><i class="fas fa-dollar-sign"></i></div>
                            <div class="stat-details">
                                <h3 id="fee-total-collected">$0</h3>
                                <p>Total Collected</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon bg-red"><i class="fas fa-exclamation-circle"></i></div>
                            <div class="stat-details">
                                <h3 id="fee-total-outstanding">$0</h3>
                                <p>Outstanding Balance</p>
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-filter-bar">
                            <div class="search-box">
                                <i class="fas fa-search"></i>
                                <input type="text" id="fee-search" placeholder="Search by student name or ID...">
                            </div>
                            <div class="filter-group">
                                <select id="filter-fee-status" class="form-control">
                                    <option value="">All Payment Statuses</option>
                                    <option value="Paid">Paid</option>
                                    <option value="Partially Paid">Partially Paid</option>
                                    <option value="Pending">Pending</option>
                                </select>
                            </div>
                        </div>
                        <div class="card-body table-responsive">
                            <table class="table" id="fees-table">
                                <thead>
                                    <tr>
                                        <th>Student ID</th>
                                        <th>Student Name</th>
                                        <th>Class</th>
                                        <th>Total Fees</th>
                                        <th>Amount Paid</th>
                                        <th>Balance Due</th>
                                        <th>Status</th>
                                        <th>Due Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="fees-table-body"></tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- 7. REPORTS VIEW -->
                <section id="reports-view" class="view-section">
                    <div class="view-header">
                        <div>
                            <h1>Reports & Analytics</h1>
                            <p>Comprehensive institutional metrics and CSV exports.</p>
                        </div>
                    </div>
                    <div class="reports-grid">
                        <div class="card">
                            <div class="card-header">
                                <h3>Student Demographic Report</h3>
                            </div>
                            <div class="card-body">
                                <p>Generate complete analytics on student gender ratios, class distribution, and active/inactive statuses.</p>
                                <button class="btn btn-primary mt-3" onclick="app.exportStudentsCSV()"><i class="fas fa-download"></i> Download Student Demographics CSV</button>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header">
                                <h3>Financial Collection Report</h3>
                            </div>
                            <div class="card-body">
                                <p>Export structured financial statements including paid invoices, due dates, and outstanding balances.</p>
                                <button class="btn btn-primary mt-3" onclick="app.exportFeesCSV()"><i class="fas fa-download"></i> Download Financial Report CSV</button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- 8. SETTINGS VIEW -->
                <section id="settings-view" class="view-section">
                    <div class="view-header">
                        <div>
                            <h1>System Settings</h1>
                            <p>Configure institution details, academic sessions, and preferences.</p>
                        </div>
                    </div>
                    <div class="card" style="max-width: 700px;">
                        <div class="card-body">
                            <form id="settings-form" onsubmit="app.saveSettings(event)">
                                <div class="form-group mb-3">
                                    <label>Institution Name</label>
                                    <input type="text" id="setting-inst-name" class="form-control" value="EduFlow Academy" required>
                                </div>
                                <div class="form-group mb-3">
                                    <label>Academic Year</label>
                                    <input type="text" id="setting-academic-year" class="form-control" value="2026 - 2027" required>
                                </div>
                                <div class="form-group mb-3">
                                    <label>Administrator Name</label>
                                    <input type="text" id="setting-admin-name" class="form-control" value="Dr. Robert Vance" required>
                                </div>
                                <div class="form-group mb-4">
                                    <label>Default Currency</label>
                                    <select id="setting-currency" class="form-control">
                                        <option value="$">USD ($)</option>
                                        <option value="€">EUR (€)</option>
                                        <option value="£">GBP (£)</option>
                                        <option value="₹">INR (₹)</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
                            </form>
                        </div>
                    </div>
                </section>

            </div>
        </main>
    </div>

    <!-- MODALS -->

    <!-- Student Modal -->
    <div class="modal" id="student-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="student-modal-title">Add New Student</h3>
                <button class="close-btn" onclick="app.closeModals()">&times;</button>
            </div>
            <form id="student-form" onsubmit="app.saveStudent(event)">
                <div class="modal-body">
                    <input type="hidden" id="student-edit-id">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Student ID *</label>
                            <input type="text" id="modal-student-id" class="form-control" required placeholder="e.g. STU1021">
                        </div>
                        <div class="form-group">
                            <label>Full Name *</label>
                            <input type="text" id="modal-student-name" class="form-control" required placeholder="Jane Doe">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Gender *</label>
                            <select id="modal-student-gender" class="form-control" required>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Date of Birth *</label>
                            <input type="date" id="modal-student-dob" class="form-control" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Class *</label>
                            <select id="modal-student-class" class="form-control" required></select>
                        </div>
                        <div class="form-group">
                            <label>Status *</label>
                            <select id="modal-student-status" class="form-control" required>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Email *</label>
                            <input type="email" id="modal-student-email" class="form-control" required placeholder="student@school.edu">
                        </div>
                        <div class="form-group">
                            <label>Phone Number *</label>
                            <input type="text" id="modal-student-phone" class="form-control" required placeholder="+1 (555) 019-2834">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Photo URL (Optional)</label>
                        <input type="url" id="modal-student-photo" class="form-control" placeholder="https://images.unsplash.com/...">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="app.closeModals()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Student</button>
                </div>
            </form>
        </div>
    </div>

    <!-- View Student Profile Modal -->
    <div class="modal" id="student-profile-modal">
        <div class="modal-content modal-lg">
            <div class="modal-header">
                <h3>Student Profile</h3>
                <button class="close-btn" onclick="app.closeModals()">&times;</button>
            </div>
            <div class="modal-body" id="student-profile-body">
                <!-- Dynamically filled -->
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="app.closeModals()">Close</button>
            </div>
        </div>
    </div>

    <!-- Teacher Modal -->
    <div class="modal" id="teacher-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="teacher-modal-title">Add Teacher</h3>
                <button class="close-btn" onclick="app.closeModals()">&times;</button>
            </div>
            <form id="teacher-form" onsubmit="app.saveTeacher(event)">
                <div class="modal-body">
                    <input type="hidden" id="teacher-edit-id">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Teacher ID *</label>
                            <input type="text" id="modal-teacher-id" class="form-control" required placeholder="TCH101">
                        </div>
                        <div class="form-group">
                            <label>Full Name *</label>
                            <input type="text" id="modal-teacher-name" class="form-control" required placeholder="Dr. Alan Turing">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Subject *</label>
                            <input type="text" id="modal-teacher-subject" class="form-control" required placeholder="Mathematics">
                        </div>
                        <div class="form-group">
                            <label>Assigned Class *</label>
                            <select id="modal-teacher-class" class="form-control" required></select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Email *</label>
                            <input type="email" id="modal-teacher-email" class="form-control" required placeholder="teacher@school.edu">
                        </div>
                        <div class="form-group">
                            <label>Phone *</label>
                            <input type="text" id="modal-teacher-phone" class="form-control" required placeholder="+1 (555) 382-9102">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Joining Date *</label>
                            <input type="date" id="modal-teacher-date" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Status *</label>
                            <select id="modal-teacher-status" class="form-control" required>
                                <option value="Active">Active</option>
                                <option value="On Leave">On Leave</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="app.closeModals()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Teacher</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Class Modal -->
    <div class="modal" id="class-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="class-modal-title">Add Class</h3>
                <button class="close-btn" onclick="app.closeModals()">&times;</button>
            </div>
            <form id="class-form" onsubmit="app.saveClass(event)">
                <div class="modal-body">
                    <input type="hidden" id="class-edit-id">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Class ID *</label>
                            <input type="text" id="modal-class-id" class="form-control" required placeholder="CLS10">
                        </div>
                        <div class="form-group">
                            <label>Class Name *</label>
                            <input type="text" id="modal-class-name" class="form-control" required placeholder="Grade 10">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Section *</label>
                            <input type="text" id="modal-class-section" class="form-control" required placeholder="Section A">
                        </div>
                        <div class="form-group">
                            <label>Class Teacher *</label>
                            <select id="modal-class-teacher" class="form-control" required></select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Room Number *</label>
                            <input type="text" id="modal-class-room" class="form-control" required placeholder="Room 302">
                        </div>
                        <div class="form-group">
                            <label>Academic Year *</label>
                            <input type="text" id="modal-class-year" class="form-control" required value="2026-2027">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="app.closeModals()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Class</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Fee Modal -->
    <div class="modal" id="fee-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="fee-modal-title">Add Fee Record</h3>
                <button class="close-btn" onclick="app.closeModals()">&times;</button>
            </div>
            <form id="fee-form" onsubmit="app.saveFee(event)">
                <div class="modal-body">
                    <input type="hidden" id="fee-edit-id">
                    <div class="form-group mb-3">
                        <label>Select Student *</label>
                        <select id="modal-fee-student" class="form-control" required></select>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Total Fees ($) *</label>
                            <input type="number" id="modal-fee-total" class="form-control" required min="0" step="0.01">
                        </div>
                        <div class="form-group">
                            <label>Amount Paid ($) *</label>
                            <input type="number" id="modal-fee-paid" class="form-control" required min="0" step="0.01">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Due Date *</label>
                            <input type="date" id="modal-fee-duedate" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Payment Status *</label>
                            <select id="modal-fee-status" class="form-control" required>
                                <option value="Pending">Pending</option>
                                <option value="Partially Paid">Partially Paid</option>
                                <option value="Paid">Paid</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" onclick="app.closeModals()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Fee Record</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-container"></div>

    <!-- App Logic Script -->
    <script src="script.js"></script>
</body>
</html>
